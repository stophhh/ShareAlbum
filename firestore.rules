rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function album(albumId) {
      return get(/databases/$(database)/documents/albums/$(albumId));
    }

    function isAlbumMember(albumId) {
      return signedIn() && request.auth.uid in album(albumId).data.memberIds;
    }

    function isAlbumOwner(albumId) {
      return signedIn() && album(albumId).data.ownerId == request.auth.uid;
    }

    function createsOwnedAlbum() {
      return signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
    }

    function joinsAlbumByInvite() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
    }

    match /albums/{albumId} {
      allow create: if createsOwnedAlbum();
      allow read: if isAlbumMember(albumId);

      allow update: if isAlbumOwner(albumId) || joinsAlbumByInvite();

      allow delete: if isAlbumOwner(albumId);

      match /photos/{photoId} {
        allow read: if isAlbumMember(albumId);

        allow create: if isAlbumMember(albumId)
          && request.resource.data.uploaderId == request.auth.uid;

        allow update: if isAlbumMember(albumId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'commentCount', 'savedBy']);

        allow delete: if isAlbumOwner(albumId)
          || (isAlbumMember(albumId) && resource.data.uploaderId == request.auth.uid);

        match /comments/{commentId} {
          allow read: if isAlbumMember(albumId);

          allow create: if isAlbumMember(albumId)
            && request.resource.data.authorId == request.auth.uid;

          allow update: if false;

          allow delete: if isAlbumOwner(albumId)
            || (isAlbumMember(albumId) && resource.data.authorId == request.auth.uid);
        }
      }
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /savedPhotos/{savedPhotoId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /inviteCodes/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/albums/$(request.resource.data.albumId)).data.ownerId == request.auth.uid;

      allow update: if false;

      allow delete: if signedIn()
        && get(/databases/$(database)/documents/albums/$(resource.data.albumId)).data.ownerId == request.auth.uid;
    }
  }
}
